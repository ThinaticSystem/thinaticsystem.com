{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": [
    "src/app/app.config.ts",
    "src/app/app.routes.ts",
    "src/app/interfaces/**/*.ts",
    "src/app/pipes/**/*.ts",
    "src/app/providers/**/*.ts",
    "src/app/services/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
