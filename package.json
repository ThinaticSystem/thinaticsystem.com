{
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "name": "thinaticsystem-com",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.spec.json --noEmit",
    "test:known-defects": "node scripts/verify-known-defects.mjs",
    "test:known-defects:contract": "node --test scripts/known-defect-probe-selection.spec.test.mjs && node scripts/verify-known-defects-fixtures.mjs && node scripts/verify-known-defect-runner-probes.mjs && node --test scripts/resolved-debt-contract.spec.test.mjs",
    "docs:check": "typedoc --options typedoc.json",
    "test:e2e": "corepack pnpm run test:browser-contract && EVIDENCE_OUTPUT=.artifacts/browser-smoke.json EVIDENCE_DIR=.artifacts/screenshots node scripts/browser-smoke.mjs",
    "perf:check": "node scripts/performance-check.mjs",
    "deploy:check": "node scripts/cloudflare-smoke.mjs",
    "check": "corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test && corepack pnpm run test:known-defects:contract && corepack pnpm run test:known-defects && corepack pnpm run test:budget-contract",
    "lint": "ng lint",
    "test:browser-contract": "node scripts/verify-browser-readiness.mjs",
    "perf:paired": "node scripts/paired-performance.mjs --baseline-control test/paired-baseline-control-v2.json --baseline-control-sha256 60320084564717481d1c20db4c413fe79f6ad751adb452ebc81ce7c2a83a0e28",
    "test:paired-contract": "node --test scripts/paired-performance-contract.spec.test.mjs scripts/paired-process.spec.test.mjs scripts/paired-continuation.spec.test.mjs",
    "test:budget-contract": "node --test scripts/functional-budget-contract.spec.test.mjs scripts/functional-budget-assets.spec.test.mjs scripts/functional-budget-evidence.spec.test.mjs",
    "perf:budget": "node scripts/functional-budget.mjs",
    "perf:current": "node scripts/performance/run.mjs",
    "test:performance-contract": "node --test --test-reporter=tap scripts/performance/contract.spec.test.mjs scripts/performance/recorder.spec.test.mjs",
    "test:performance-recorder": "node scripts/performance/verify-recorder.mjs",
    "test:preview-contract": "node --test scripts/preview-deploy-contract.spec.test.mjs scripts/preview-deploy-contract.regression.test.mjs scripts/preview-deployment.spec.test.mjs scripts/preview-deployment.regression.test.mjs scripts/preview-smoke-shell.regression.test.mjs scripts/build-pages.regression.test.mjs && node --test scripts/pages-patrons-proxy.spec.test.mjs",
    "test:observation-pilot": "node scripts/observation/pilot-v3/run.mjs",
    "test:preview-smoke-contract": "node --test scripts/build-pages.regression.test.mjs scripts/preview-smoke-assets.spec.test.mjs scripts/preview-smoke-article.regression.test.mjs scripts/preview-smoke-shell.regression.test.mjs && node --test scripts/pages-patrons-proxy.spec.test.mjs",
    "test:performance-policy": "node --test scripts/performance/policy-version.spec.test.mjs scripts/performance/policy-v3.regression.test.mjs scripts/performance/policy-v4.regression.test.mjs",
    "test:observation-full": "node scripts/observation/v3-full/run.mjs",
    "test:patrons-proxy-contract": "node --test scripts/pages-patrons-proxy.spec.test.mjs"
  },
  "private": true,
